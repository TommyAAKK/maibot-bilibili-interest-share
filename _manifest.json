{
  "manifest_version": 2,
  "id": "github.TommyAAKK.bilibili_interest_share",
  "version": "1.0.1",
  "name": "麦麦刷B站",
  "description": "定时刷 B 站，按白名单聊天流的用户兴趣挑选有趣的视频分享。支持抽帧看画面、读弹幕与热门评论、LLM 语义判断与内容总结、按 MaiBot 人设口吻写分享文案、已刷名单、主动搜索与 /赤石视频。刷取频率可在配置中调节，每个配置项都带中文注释。",
  "author": {
    "name": "TommyAAKK",
    "url": "https://github.com/TommyAAKK"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/TommyAAKK/maibot-bilibili-interest-share"
  },
  "plugin_type": "integration",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.9.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "message.get_recent",
    "llm.generate",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
